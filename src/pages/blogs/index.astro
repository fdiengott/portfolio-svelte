---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import SectionBanner from '../../components/SectionBanner.astro';
import Pin from '../../components/Pin.astro';
import { formatDate } from '../../utils/formatDate';

const allPosts = await getCollection('blog');

const sortedPosts = allPosts.sort((a, b) => {
	if (a.data.pinned) return -1;
	if (b.data.pinned) return 1;
	if (new Date(a.data.date) <= new Date(b.data.date)) return 1;
	return -1;
});
---

<BaseLayout flush title="Freddy Diengott - Blog">
	<SectionBanner as="h1">Blog</SectionBanner>
	<ul class="posts">
		{sortedPosts.map((post) => (
			<PostRow post={post} />
		))}
	</ul>
</BaseLayout>

<style>
	.posts {
		margin: 0;
		padding: 0;
	}
</style>
