---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import SectionBanner from '../../components/SectionBanner.astro';

import { formatDate } from '../../utils/formatDate';

interface Props {
	entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
	const blogEntries = (await getCollection('blog')) as CollectionEntry<'blog'>[];
	return blogEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isSearchable = entry.data.searchable;

const publishedDate = formatDate(entry.data.date);
---

<BaseLayout flush title={`Freddy Diengott - ${entry.data.title}`}>
	<SectionBanner as="h1">
		{entry.data.title}
		<p slot="sub" class="banner-date">
			First published on <time datetime={entry.data.date}>{publishedDate}</time>.
		</p>
	</SectionBanner>
	<article id="blog__container">
		<div class="blog__back">
			<Button size="sm" href="/blogs">
				Back
			</Button>
		</div>
		<div id="content__container">
			{isSearchable && (
				<input class="book-search" type="search" placeholder="Search books..." id="book-search-input" />
			)}
			<Content />
		</div>
	</article>
	<div class="scroll-top">
		<Button size="sm" id="scroll-top-btn" aria-label="Scroll to top">
			↑
		</Button>
	</div>
</BaseLayout>

<script>
	const searchInput = document.getElementById('book-search-input');
	if (searchInput) {
		searchInput.addEventListener('input', (e) => {
			const query = (e.target as HTMLInputElement).value.toLowerCase();
			const container = document.getElementById('blog__container');
			if (!container) return;
			const listItems = container.querySelectorAll('ul > li');
			listItems.forEach((li) => {
				const text = li.textContent?.toLowerCase() ?? '';
				if (!query || text.includes(query)) {
					(li as HTMLElement).style.display = '';
				} else {
					(li as HTMLElement).style.display = 'none';
				}
			});
		});
	}

	const scrollTopBtn = document.getElementById('scroll-top-btn');
	if (scrollTopBtn) {
		scrollTopBtn.addEventListener('click', () => {
			window.history.pushState({}, '', window.location.href.split('#')[0]);
			window.scrollTo(0, 0);
		});
	}
</script>

<style is:global>
	.banner-date {
		margin: 4px 0 0;
		font-family: var(--font-body);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		color: var(--paper);
		opacity: 0.85;
	}

	.blog__back {
		margin-block-end: 1.5rem;
		padding-inline-end: 8px;
	}

	@media (min-width: 920px) {
		.blog__back {
			position: absolute;
			top: var(--container-top-spacing);
			left: var(--container-top-spacing);
			margin: 0;
			padding: 0;
		}
	}

	.scroll-top {
		position: fixed;
		right: 24px;
		bottom: 24px;
		z-index: 2;
	}

	.book-search {
		display: block;
		width: 100%;
		max-width: 24rem;
		padding: 0.4rem 0.6rem;
		margin-block-end: 1.5rem;
		font-family: var(--font-ui);
		font-size: var(--fs-300);
		color: var(--ink);
		background: var(--card);
		border: 2px solid var(--ink);
		border-radius: 0;
	}
	.book-search:focus-visible {
		outline: 3px dashed var(--pen);
		outline-offset: 4px;
	}

	#blog__container {
		--block-spacing: 1.5rem;
		--container-top-spacing: 24px;
		position: relative;
		padding: var(--container-top-spacing) 22px 48px;
		font-family: var(--font-body);
		font-size: var(--fs-350);
		color: var(--soft);
	}

	#content__container {
		margin-inline: auto;
		width: 100%;
		max-width: calc(65ch + 44px);
	}

	#blog__container :is(h1, h2, h3, h4, h5, h6) {
		font-family: var(--font-heading);
		color: var(--ink);
	}

	#blog__container h2,
	#blog__container h3,
	#blog__container h4 {
		margin-block: 1em 0.75rem;
	}

	#blog__container p,
	#blog__container ol,
	#blog__container ul {
		margin-block-end: 1lh;
	}

	#blog__container p {
		line-height: 1.7rem;
	}

	#blog__container table:not(:has(code)) {
		margin-block: 3rem;
	}

	#blog__container .table-of-contents + ul,
	#blog__container .table-of-contents + ul li {
		margin-block-start: 0.3em;
	}

	#blog__container ol {
		display: grid;
		gap: 2rem;
	}

	#blog__container ul,
	#blog__container ol {
		margin-inline-start: 1.2rem;
	}

	#blog__container ol li {
		list-style: auto;
		list-style-position: inside;
	}

	#blog__container ul li {
		list-style: outside;
	}

	#blog__container > ul:not(:has(ul)) {
		display: grid;
		gap: 1.5rem;
	}

	#blog__container ol > li > ul {
		margin-inline-start: 2rem;
	}

	#blog__container li:has(code) {
		overflow-x: scroll;
	}

	#blog__container :is(h1, h2, h3, h4, h5, h6) > a {
		color: inherit;
		text-decoration: none;
	}

	#blog__container :is(h1, h2, h3, h4, h5, h6) > a:hover {
		text-decoration: underline;
		text-decoration-color: var(--marker);
		text-underline-offset: 6px;
	}

	#blog__container :is(h1, h2, h3, h4, h5, h6) > a:focus-visible {
		outline: 3px dashed var(--pen);
		outline-offset: 4px;
	}

	#blog__container pre {
		padding: 1rem 1.25rem;
		background: var(--card) !important;
		border: 2px solid var(--ink);
		border-radius: 0;
		overflow-x: auto;
		margin-block-end: 1lh;
		font-size: var(--fs-300);
		tab-size: 4;
	}

	#blog__container table:has(code),
	#blog__container tr,
	#blog__container td {
		background: var(--card);
	}

	#blog__container table:has(code) {
		width: 100%;
		border: 2px solid var(--ink);
		border-radius: 0;
		font-size: var(--fs-300);
		margin-block-end: 1lh;
	}

	#blog__container table:has(code) code {
		padding: 0;
		margin: 0;
		border: none;
	}

	#blog__container table:has(code) tr:first-child td,
	#blog__container table:has(code) tr:last-child td {
		border-radius: 0;
	}

	#blog__container p > code {
		background: var(--card);
		padding: 0.1rem 0.3rem;
		border: 1px solid var(--rule);
		border-radius: 0;
		font-family: var(--font-code);
		font-size: var(--fs-300);
	}

	#blog__container blockquote {
		padding: 2rem 3rem;
		margin-block-start: -1rem;
		background: var(--card);
		border-inline-start: 4px solid var(--pen);
	}

	#blog__container blockquote p {
		margin: 0;
	}

	#blog__container table:not(:has(code)) {
		margin-inline: auto;
		font-size: var(--fs-300);
		display: block;
		overflow-x: scroll;
	}

	#blog__container table:not(:has(code)) th,
	#blog__container table:not(:has(code)) td {
		--border-color: var(--rule);
		border-bottom: 1px solid var(--border-color);
		min-width: 10rem;
	}

	#blog__container table:not(:has(code)) td {
		padding: 1.2rem 0.8rem;
	}

	#blog__container p:has(img) {
		text-align: center;
	}

	@media (width > 768px) {
		#blog__container ol li {
			list-style-position: outside;
		}

		#blog__container li:has(code) {
			overflow: visible;
		}

		#blog__container table {
			overflow: visible;
			display: revert;
		}
	}

	#blog__container .hljs {
		background: var(--card);
	}

	#blog__container .nyc-activities-start ~ .header-wrapper {
		margin-block-start: 2rem;
		border-block-start: 1px solid hsla(0 50% 0% / 0.2);
	}

	#blog__container .nyc-activities-start + .header-wrapper {
		margin-block-start: 0;
		border-block-start: none;
	}

	#blog__container .nyc-activities-start ~ :not(.header-wrapper) {
		margin-inline-start: 2rem;
	}

	#blog__container .nyc-activities-start ~ .header-wrapper > h3 {
		margin-block-end: 0;
	}

	#blog__container .arrow {
		text-align: center;
	}

	#blog__container blockquote div:not(.arrow) + div {
		padding-block-end: 2rem;
	}

	#blog__container .career-planning-in-the-age-of-ai {
		--block-spacing: 2rem;
	}

	#blog__container .career-planning-in-the-age-of-ai ~ ol,
	#blog__container .career-planning-in-the-age-of-ai ~ ul {
		gap: 0.75rem;
	}

	#blog__container .career-planning-in-the-age-of-ai ~ ul + * {
		margin-block-start: var(--block-spacing);
	}
</style>
