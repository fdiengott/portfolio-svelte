---
interface Props {
	/** Heading level to render. Use 'h1' when the banner is the page title. */
	as?: 'h1' | 'h2';
}
const { as: Tag = 'h2' } = Astro.props;
---

<div class="banner">
	<Tag>
		<slot />
	</Tag>
	<slot name="sub" />
</div>

<style>
	.banner {
		background: var(--ink);
		color: var(--paper);
		padding: 10px 22px;
	}
	.banner :global(h1),
	.banner :global(h2) {
		margin: 0;
		font-family: var(--display);
		font-style: italic;
		font-weight: 500;
		font-size: 24px;
		line-height: 1.2;
		color: var(--paper);
	}
</style>
