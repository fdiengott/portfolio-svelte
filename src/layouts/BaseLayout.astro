---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';

interface Props {
	title: string;
	description?: string;
	/** Drop the default main padding so full-bleed banners can span the wrapper. */
	flush?: boolean;
}

/** 'gazette' | 'workshop'. Sets data-buttons on <html>; see buttons.css (step 2). */
const BUTTON_STYLE = 'workshop';

/** Add families here (Google Fonts css2 `family=` values) to experiment with type. */
const FONT_FAMILIES = [
	'Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500',
	'Archivo:wght@400;600',
	'Barlow+Condensed:wght@600',
	'Ballet:opsz@16..72', // TEMP: home title experiment
];
const fontsHref = `https://fonts.googleapis.com/css2?${FONT_FAMILIES.map((f) => `family=${f}`).join('&')}&display=swap`;

const {
	title,
	flush = false,
	description = 'A software engineer with a specialty in writing explicitly maintainable, efficient code...and also a big nerd.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-buttons={BUTTON_STYLE}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={fontsHref} />
		<title>{title}</title>
	</head>
	<body>
		<div class="wrapper">
			<Header />
			<main class:list={{ flush }}>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.wrapper {
		position: relative;
		max-width: 980px;
		width: calc(100% - 28px);
		margin: 28px auto 70px;
		background: var(--paper);
		border: 4px solid var(--ink);
		border-radius: 0;
	}
	@media (max-width: 999px) {
		.wrapper {
			margin-block-start: 36px; /* a little more pattern above the header on phones */
		}
	}

	/* red registration marks, top-left and bottom-right */
	.wrapper::before,
	.wrapper::after {
		content: '';
		position: absolute;
		width: 16px;
		height: 16px;
		border: 0 solid var(--marker);
		pointer-events: none;
		z-index: 1;
	}
	.wrapper::before {
		top: 8px;
		left: 8px;
		border-top-width: 2px;
		border-left-width: 2px;
	}
	.wrapper::after {
		bottom: 8px;
		right: 8px;
		border-bottom-width: 2px;
		border-right-width: 2px;
	}

	main {
		padding: 24px 22px;
	}
	main.flush {
		padding: 0;
	}
</style>
